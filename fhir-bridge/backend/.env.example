# FHIR EHR Bridge configuration. Copy to the repository root as `.env` (development)
# or to /etc/fhir-bridge/.env (Ubuntu service). Never commit a filled-in copy.
# No EHR, patient, user or tenant is selected by default: every EHR block below must be
# completed before that EHR is registered. Values in <angle brackets> are placeholders.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# APP_ENV=development               # the Ubuntu unit sets production; leave unset there (installer refuses it)
HTTP_TIMEOUT=30                     # seconds per EHR request
MAX_RESULTS=25                      # patients per EHR per search (1-100)
FHIR_MAX_PAGES=5                    # Bundle pages followed per search; results beyond this are flagged partial
MAX_SELECTIONS=4                    # records that may be combined into one summary

# ---------------------------------------------------------------------------
# Sign-in with Microsoft Entra ID (Azure AD). See SSO_SETUP.md. Required in production;
# leave all five empty in development to run without login.
# ---------------------------------------------------------------------------
SSO_TENANT_ID=<Directory (tenant) ID from the app registration overview>
SSO_CLIENT_ID=<Application (client) ID from the app registration overview>
SSO_CLIENT_SECRET=<client secret value (not its ID)>
SSO_BASE_URL=<public URL of this app, e.g. https://bridge.example.org; redirect URI is SSO_BASE_URL/auth/callback>
SESSION_SECRET=<random, at least 32 chars: openssl rand -hex 32>
SESSION_HOURS=8                     # sign-in lifetime

# ---------------------------------------------------------------------------
# Cerner / Oracle Health (Millennium FHIR R4, SMART Backend Services)
# ---------------------------------------------------------------------------
CERNER_ENABLED=true
CERNER_BASE_URL=https://fhir-ehr.cerner.com/r4/<tenant-id>
CERNER_TOKEN_URL=https://authorization.cerner.com/tenants/<tenant-id>/protocols/oauth2/profiles/smart-v1/token
CERNER_CLIENT_ID=<client id from Cerner Code Console>
CERNER_AUTH_METHOD=private_key_jwt  # private_key_jwt (JWKS registered on the system account) | client_secret_basic
CERNER_PRIVATE_KEY_PATH=<path to private_key.pem>
CERNER_KID=<kid published in your JWKS>
CERNER_ALG=RS384                    # Cerner verifies RS384 / ES384 only
# CERNER_CLIENT_SECRET=             # only for client_secret_basic
CERNER_SCOPE=system/Patient.read system/Condition.read system/MedicationRequest.read system/AllergyIntolerance.read system/Observation.read system/Encounter.read

# ---------------------------------------------------------------------------
# athenahealth (FHIR R4, 2-legged OAuth). No approval email was provided; fill in from the
# athenahealth developer portal once the app is approved. Preview host: api.preview.platform...
# ---------------------------------------------------------------------------
ATHENA_ENABLED=true
ATHENA_BASE_URL=<https://api.platform.athenahealth.com/fhir/r4 or the preview host>
ATHENA_TOKEN_URL=<https://api.platform.athenahealth.com/oauth2/v1/token or the preview host>
ATHENA_CLIENT_ID=<client id from the athenahealth portal>
ATHENA_PRACTICE_ID=<numeric practice id; sent as ah-practice=Organization/a-1.Practice-<id>>
ATHENA_AUTH_METHOD=private_key_jwt  # private_key_jwt (JWKS) | client_secret_basic
ATHENA_PRIVATE_KEY_PATH=<path to private_key.pem>
ATHENA_KID=<kid published in your JWKS>
ATHENA_ALG=RS384
# ATHENA_CLIENT_SECRET=             # only for client_secret_basic
ATHENA_SCOPE=system/Patient.read system/Condition.read system/MedicationRequest.read system/AllergyIntolerance.read system/Observation.read system/Encounter.read

# ---------------------------------------------------------------------------
# AI summarization (see AI_PROVIDERS.md). Patient facts are sent to AI_BASE_URL's host for
# every provider except `extractive`. There is no automatic fallback to another provider.
# ---------------------------------------------------------------------------
AI_PROVIDER=extractive              # extractive | ollama | openai_compat | anthropic | snowflake
AI_MODEL=                           # e.g. llama3.2 | claude-sonnet-5-5 | gpt-4o-mini | llama3.1-70b
AI_BASE_URL=                        # ollama: http://localhost:11434 (default) | openai_compat: https://host/v1 | anthropic: private gateway (optional)
AI_API_KEY=                         # bearer / x-api-key / Snowflake PAT as the provider requires
# SNOWFLAKE_ACCOUNT=                # snowflake only, e.g. ab12345.us-east-1 (or set AI_BASE_URL)
AI_TIMEOUT=90
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_INPUT_CHARS=24000            # facts beyond this are dropped and reported as omitted
AI_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# Logging (no patient data or secrets are ever logged)
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_DIR=logs                      # set by the Ubuntu unit (/var/log/fhir-bridge); leave unset there
# LOG_TO_CONSOLE=true               # set by the Ubuntu unit (false); leave unset there
LOG_FILE=app.log
LOG_MAX_BYTES=2000000
LOG_BACKUP_COUNT=5
